FROM  golang:1.24.6 AS golang

FROM gcc:6.5.0

COPY unixODBC-2.3.12.tar.gz /tmp/
WORKDIR /tmp
RUN tar zxvf unixODBC-2.3.12.tar.gz && \
    cd unixODBC-2.3.12 && \
    ./configure \
        --prefix=/usr/local \
        --enable-shared \
        --disable-static \
        --sysconfdir=/etc && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/unixODBC-2.3.12*

RUN odbc_config --version && \
    odbcinst -j
